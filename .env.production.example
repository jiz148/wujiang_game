# Copy to .env.production and replace every example value before deployment.
WUJIANG_DOMAIN=game.example.com
WUJIANG_OPS_TOKEN=replace-with-at-least-32-random-characters

# Optional tuning. Keep the default image family unless a tested digest is pinned by release operations.
PYTHON_IMAGE=python:3.12-slim-bookworm
WUJIANG_MAX_JSON_BODY_BYTES=262144
WUJIANG_SLOW_REQUEST_MS=1500
